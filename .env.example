# ============================================
# Environment Configuration Example
# ============================================
# Copy this to .env for development
# For Discloud, set these in the dashboard

# Node environment (development or production)
NODE_ENV=development

# Session secret (use a strong random string)
SESSION_SECRET=your-very-secure-random-secret-at-least-32-chars

# Steam API Configuration
STEAM_API_KEY=your-steam-api-key-from-steamcommunity.com
STEAM_ADMINS=76561198419559590
FRONTEND_URL=http://192.168.1.66:3000
STEAM_RETURN_URL=http://192.168.1.66:3000/auth/steam/return
STEAM_REALM=http://192.168.1.66:3000

# Proxy trust (set to 1 in production with Discloud)
TRUST_PROXY=0

# Optional: Allow server-side build (not recommended)
# ALLOW_SERVER_BUILD=1
